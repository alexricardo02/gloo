generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
}

model User {
  id                  String        @id @default(cuid())
  name                String
  username            String?       @unique
  email               String        @unique
  password            String
  birthDate           DateTime
  role                Role          @default(USER)
  isGuest             Boolean       @default(false)
  image               String?
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt
  isVerified          Boolean       @default(false)
  verificationToken   String?       @unique
  verificationTokenExpiry DateTime?
  resetPasswordExpiry DateTime?
  resetPasswordToken  String?       @unique
  chatsInitiated      Chat[]        @relation("HostA")
  chatsReceived       Chat[]        @relation("HostB")
  events              Event[]
  gameScores          GameScore[]
  group               Group?        @relation("HostGroup")
  blockedGroups       GroupBlock[]
  filedReports        GroupReport[]
  messages            Message[]
  sessions            Session[]
}

model Group {
  id               String            @id @default(cuid())
  description      String?
  membersCount     Int               @default(1)
  ageMin           Int               @default(18)
  ageMax           Int               @default(30)
  searchAgeMax     Int               @default(35)
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  instagram        String[]
  maxDistance      Int               @default(10)
  photos           String[]
  userId           String            @unique
  isPartyMode      Boolean           @default(false)
  latitude         Float?
  longitude        Float?
  gender           Gender            @default(MIXED)
  searchGender     Gender            @default(MIXED)
  publicProfile    Boolean           @default(true)
  searchAgeMin     Int               @default(18)
  eventAttendances EventAttendance[]
  user             User              @relation("HostGroup", fields: [userId], references: [id], onDelete: Cascade)
  blocksReceived   GroupBlock[]
  likesSent        GroupLike[]       @relation("LikesSent")
  likesReceived    GroupLike[]       @relation("LikesReceived")
  reportsReceived  GroupReport[]
  venueAttendances VenueAttendance[]

  @@index([latitude, longitude])
  @@index([publicProfile, isPartyMode, gender])
}

model GroupLike {
  id          String   @id @default(cuid())
  fromGroupId String
  toGroupId   String
  createdAt   DateTime @default(now())
  fromGroup   Group    @relation("LikesSent", fields: [fromGroupId], references: [id], onDelete: Cascade)
  toGroup     Group    @relation("LikesReceived", fields: [toGroupId], references: [id], onDelete: Cascade)

  @@unique([fromGroupId, toGroupId])
  @@index([toGroupId])
}

model Event {
  id           String            @id @default(cuid())
  title        String
  description  String?
  locationName String
  latitude     Float
  longitude    Float
  startTime    DateTime
  endTime      DateTime?
  ownerId      String
  createdAt    DateTime          @default(now())
  owner        User              @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  attendees    EventAttendance[]
}

/// One conversation between two hosts. The pair is stored in canonical order
/// (hostAId < hostBId, byte order; enforced by the "Chat_canonical_pair_check"
/// CHECK constraint in migration 20261111130000_chat_origin_and_system_messages),
/// so @@unique([hostAId, hostBId]) makes the pair unique regardless of who
/// started the chat. Rows are only created through ensureChat() in lib/chats.ts.
model Chat {
  id        String     @id @default(cuid())
  hostAId   String
  hostBId   String
  /// Why the chat exists. No default on purpose: every creator must state it.
  origin    ChatOrigin
  createdAt DateTime   @default(now())
  hostA     User       @relation("HostA", fields: [hostAId], references: [id], onDelete: Cascade)
  hostB     User       @relation("HostB", fields: [hostBId], references: [id], onDelete: Cascade)
  messages  Message[]

  @@unique([hostAId, hostBId])
  @@index([hostAId])
  @@index([hostBId])
}

/// USER messages have a sender (null only after the sender's account was
/// deleted). SYSTEM messages have senderId = null and a systemKey that the UI
/// renders via i18n (Chat.systemMessages.<key>); their `text` is not shown.
/// @@unique([chatId, systemKey]) allows at most one notice of each kind per
/// chat (Postgres treats the NULL systemKey of USER messages as distinct).
model Message {
  id        String            @id @default(cuid())
  text      String
  chatId    String
  senderId  String?
  type      MessageType       @default(USER)
  systemKey SystemMessageKey?
  createdAt DateTime          @default(now())
  chat      Chat              @relation(fields: [chatId], references: [id], onDelete: Cascade)
  sender    User?             @relation(fields: [senderId], references: [id], onDelete: SetNull )

  @@unique([chatId, systemKey])
  @@index([chatId, createdAt(sort: Desc)])
}

model GameScore {
  id        String   @id @default(cuid())
  gameName  String
  score     Int
  userId    String?
  guestId   String?
  createdAt DateTime @default(now())
  user      User?    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([gameName, score(sort: Desc)])
}

model EventAttendance {
  id        String   @id @default(cuid())
  groupId   String
  eventId   String
  createdAt DateTime @default(now())
  status    String   @default("Pending")
  event     Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  group     Group    @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@unique([groupId, eventId])
}

model Venue {
  id        String            @id @default(cuid())
  name      String
  type      String
  latitude  Float
  longitude Float
  createdAt DateTime          @default(now())
  attendees VenueAttendance[]
}

model VenueAttendance {
  id        String   @id @default(cuid())
  groupId   String
  venueId   String
  createdAt DateTime @default(now())
  group     Group    @relation(fields: [groupId], references: [id], onDelete: Cascade)
  venue     Venue    @relation(fields: [venueId], references: [id], onDelete: Cascade)

  @@unique([groupId, venueId])
}

model GroupBlock {
  id             String   @id @default(cuid())
  blockerId      String
  blockedGroupId String
  createdAt      DateTime @default(now())
  blockedGroup   Group    @relation(fields: [blockedGroupId], references: [id], onDelete: Cascade)
  blocker        User     @relation(fields: [blockerId], references: [id], onDelete: Cascade)

  @@unique([blockerId, blockedGroupId])
}

model GroupReport {
  id              String   @id @default(cuid())
  reporterId      String
  reportedGroupId String
  reason          String?
  createdAt       DateTime @default(now())
  reportedGroup   Group    @relation(fields: [reportedGroupId], references: [id], onDelete: Cascade)
  reporter        User     @relation(fields: [reporterId], references: [id], onDelete: Cascade)

  @@unique([reporterId, reportedGroupId])
}

/// Server-side login session. The cookie holds only a random token; the DB
/// stores its SHA-256 hash, so a DB leak does not leak usable session tokens.
model Session {
  id         String   @id @default(cuid())
  tokenHash  String   @unique
  userId     String
  createdAt  DateTime @default(now())
  expiresAt  DateTime
  lastUsedAt DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

enum Role {
  USER
  BAR_OWNER
}

enum Gender {
  MALE
  FEMALE
  MIXED
  DIVERSE
}

/// MATCH: created by a mutual like. EVENT_ACCESS: reserved for accepted
/// pre-party attendance (not implemented yet). LEGACY: existed before chats
/// required a match; kept fully working.
enum ChatOrigin {
  MATCH
  EVENT_ACCESS
  LEGACY
}

enum MessageType {
  USER
  SYSTEM
}

enum SystemMessageKey {
  MATCH_CREATED
}

enum GroupType {
  FRIENDS
  DATES
  NETWORKING
}
