# Test environment — used ONLY by Vitest and Playwright.
# Copy to `.env.test` (gitignored):   cp .env.test.example .env.test
#
# The test runners never read `.env`. They refuse to start unless
# TEST_DATABASE_URL points at localhost / 127.0.0.1 / ::1 AND the database
# name ends in "_test". DATABASE_URL and DIRECT_URL are forced to this value
# for every test process.
#
# Matches the local Docker container from docker-compose.yml (port 5433).
# Create the database once with:   npm run test:db:create
TEST_DATABASE_URL="postgresql://party_admin:party_password123@localhost:5433/gloo_test?schema=public"

# Dummy values so modules that require them can be imported in tests.
NEXT_PUBLIC_SUPABASE_URL="https://dummy-project.supabase.co"
# Tests never upload to a real bucket: unit tests mock lib/storage.ts and the
# Playwright dev server is pinned to the bucket below with no service-role key.
SUPABASE_STORAGE_BUCKET="gloo-images-e2e"

# Optional: shared secret for the /api/e2e helper used by Playwright's
# global-setup. If empty, playwright.config.ts generates one per run.
E2E_TEST_SECRET=""

# Optional: port for the dev server Playwright starts (default 3100).
# E2E_PORT=3100

# Optional: email-dependent flows (verification, password recovery); default off.
# Unit/integration tests set this per test. The Playwright dev server gets the
# value from here or from your shell (defaults to "false"); the default E2E run
# expects it off.
# EMAIL_FLOWS_ENABLED="false"
