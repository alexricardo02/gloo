DATABASE_URL="postgresql://party_admin:party_password123@localhost:5433/gloo_db?schema=public"
DIRECT_URL="postgresql://party_admin:party_password123@localhost:5433/gloo_db?schema=public"

NEXT_PUBLIC_SUPABASE_URL="https://dummy-project.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="dummy-anon-key-for-local-compilation-and-testing-purposes"

# Supabase Storage (group photos, profile images). See README -> Image Storage.
# SUPABASE_SERVICE_ROLE_KEY is a FULL-ACCESS SECRET (it bypasses every RLS
# policy on the whole project). It must only exist on the server: never commit
# it, never expose it to the browser, and never add a NEXT_PUBLIC_ copy.
# Dashboard -> Project Settings -> API Keys -> "service_role" (secret).
SUPABASE_SERVICE_ROLE_KEY=""
# Bucket for uploads. Production uses "gloo-images" (the default when unset).
# Local development MUST use a separate bucket so dev runs never touch
# production photos, e.g. "gloo-images-dev".
SUPABASE_STORAGE_BUCKET="gloo-images-dev"

# Upstash Redis for rate limiting (login, register, password reset, username check, likes).
# Get these from https://console.upstash.com/
# REQUIRED in production: the server refuses to start without them. In development an
# in-memory fallback is used instead (a warning is logged).
UPSTASH_REDIS_REST_URL="https://YOUR-UPSTASH-ENDPOINT.upstash.io"
UPSTASH_REDIS_REST_TOKEN="YOUR-UPSTASH-TOKEN"

# Required for stable Server Action IDs across multiple server instances / deploys.
# Generate with: openssl rand -base64 32
NEXT_SERVER_ACTIONS_ENCRYPTION_KEY=""

# Email-dependent flows (account verification, password recovery).
# Off by default because there is no email provider yet. While off, users are
# signed in right after registering (accounts stay unverified), login does not
# require a verified email, and the forgot/reset-password pages show an
# "unavailable" notice. Set to "true" only once a real email provider and a
# verified sending domain are configured. Server-side only: do NOT add a
# NEXT_PUBLIC_ copy.
EMAIL_FLOWS_ENABLED="false"